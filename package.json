{
  "name": "is-odd-or-even-week",
  "version": "0.0.2",
  "main": "index.html",
  "type": "module",
  "author": "Shazron Abdullah",
  "license": "UNLICENSED",
  "keywords": [
    "vanilla",
    "javascript",
    "template",
    "boilerplate",
    "boilerplate-template",
    "postcss",
    "eslint",
    "prettier",
    "scaffold",
    "scaffold-template",
    "vite",
    "vitejs",
    "vite-template",
    "vitejs-template"
  ],
  "scripts": {
    "dev": "vite --host --open",
    "lint": "eslint --ext .js ./",
    "lint:fix": "eslint --fix --ext .js ./",
    "format": "prettier --write \"./**/*.{js,jsx,json,css}\"",
    "build": "vite build",
    "preview": "vite preview --open",
    "buildpreview": "vite build && vite preview --open",
    "precaprover:build": "npm run build",
    "caprover:build": "cd dist && tar -czf ../caprover.tar .",
    "precaprover:deploy": "npm run caprover:build",
    "caprover:deploy": "npx caprover deploy --configFile caprover.config.json",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.7",
    "eslint": "^9",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.1",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.6.2",
    "vite": "7.1.3",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "posthog-js": "^1.257.0",
    "the-new-css-reset": "^1.11.3"
  }
}
